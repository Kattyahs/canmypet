{
  "info": {
    "name": "CanMyPet - Public API",
    "description": "Read-only food safety lookups for external consumers, plus the setup requests needed to load and verify data in a fresh CanMyPet instance. See docs/public-api/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "apiKey", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "vetName", "value": "Demo Veterinarian" },
    { "key": "vetEmail", "value": "vet@example.com" },
    { "key": "vetPassword", "value": "changeme123" },
    { "key": "adminToken", "value": "" },
    { "key": "vetToken", "value": "" },
    { "key": "vetId", "value": "" },
    { "key": "foodId", "value": "" },
    { "key": "foodSafetyId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Public API",
      "item": [
        {
          "name": "Search foods with safety (dog)",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{apiKey}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/public/v1/foods/safety?query=choco&species=DOG",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "public", "v1", "foods", "safety" ],
              "query": [
                { "key": "query", "value": "choco" },
                { "key": "species", "value": "DOG" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has results', () => pm.expect(pm.response.json()).to.have.property('results'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search foods with safety (cat, puppy stage)",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{apiKey}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/public/v1/foods/safety?query=choco&species=CAT&lifeStage=PUPPY",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "public", "v1", "foods", "safety" ],
              "query": [
                { "key": "query", "value": "choco" },
                { "key": "species", "value": "CAT" },
                { "key": "lifeStage", "value": "PUPPY" }
              ]
            }
          }
        },
        {
          "name": "Error - missing API key (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/v1/foods/safety?query=choco&species=DOG",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "public", "v1", "foods", "safety" ],
              "query": [
                { "key": "query", "value": "choco" },
                { "key": "species", "value": "DOG" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Code is INVALID_API_KEY', () => pm.expect(pm.response.json().code).to.eql('INVALID_API_KEY'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error - invalid species (400)",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{apiKey}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/public/v1/foods/safety?query=choco&species=PERRO",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "public", "v1", "foods", "safety" ],
              "query": [
                { "key": "query", "value": "choco" },
                { "key": "species", "value": "PERRO" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Code is INVALID_PARAMETER', () => pm.expect(pm.response.json().code).to.eql('INVALID_PARAMETER'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Setup - load and verify data",
      "description": "Run these in order once, on a fresh instance. The public API only returns evaluations that a verified veterinarian has verified.",
      "item": [
        {
          "name": "01 Admin login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "login" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Create food (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chocolate\",\n  \"category\": \"human food\",\n  \"description\": \"Contains theobromine and caffeine\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "foods" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('foodId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Create food safety entry (admin, starts PENDING)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodId\": {{foodId}},\n  \"species\": \"DOG\",\n  \"lifeStage\": null,\n  \"riskLevel\": \"TOXIC\",\n  \"notes\": \"Contiene teobromina. Puede causar vómitos, arritmias y convulsiones.\",\n  \"sources\": [\n    {\n      \"sourceName\": \"ASPCA Animal Poison Control\",\n      \"sourceUrl\": \"https://www.aspca.org/pet-care/animal-poison-control\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/food-safety",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "food-safety" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('foodSafetyId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Register veterinarian",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{vetName}}\",\n  \"email\": \"{{vetEmail}}\",\n  \"password\": \"{{vetPassword}}\",\n  \"role\": \"VETERINARIAN\",\n  \"licenseNumber\": \"DEMO-0001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "register" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('vetId', pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Approve veterinarian (admin)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{vetId}}/verify",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "users", "{{vetId}}", "verify" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Veterinarian login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vetEmail}}\",\n  \"password\": \"{{vetPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "login" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('vetToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Verify food safety entry (veterinarian)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Authorization", "value": "Bearer {{vetToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/food-safety/{{foodSafetyId}}/verify",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "food-safety", "{{foodSafetyId}}", "verify" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Entry is VERIFIED', () => pm.expect(pm.response.json().verifiedStatus).to.eql('VERIFIED'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
