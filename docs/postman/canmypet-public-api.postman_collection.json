{
  "info": {
    "name": "CanMyPet - Public API",
    "description": "Read-only food safety lookups for external consumers. The instance comes preloaded with verified demo data, so folder 1 works right away. Folder 2 is optional and only needed to add foods that are not in the preloaded catalog. See docs/public-api/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "vetName",
      "value": "Demo Veterinarian"
    },
    {
      "key": "vetEmail",
      "value": "vet@example.com"
    },
    {
      "key": "vetPassword",
      "value": "changeme123"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "vetToken",
      "value": ""
    },
    {
      "key": "vetId",
      "value": ""
    },
    {
      "key": "foodId",
      "value": ""
    },
    {
      "key": "foodSafetyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Public API",
      "item": [
        {
          "name": "Search foods with safety (dog)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/public/v1/foods/safety?query=uva&species=DOG",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "v1",
                "foods",
                "safety"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "uva"
                },
                {
                  "key": "species",
                  "value": "DOG"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has results', () => pm.expect(pm.response.json()).to.have.property('results'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search foods with safety (cat, puppy stage)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/public/v1/foods/safety?query=choco&species=CAT&lifeStage=PUPPY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "v1",
                "foods",
                "safety"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "choco"
                },
                {
                  "key": "species",
                  "value": "CAT"
                },
                {
                  "key": "lifeStage",
                  "value": "PUPPY"
                }
              ]
            }
          }
        },
        {
          "name": "Error - missing API key (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/v1/foods/safety?query=choco&species=DOG",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "v1",
                "foods",
                "safety"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "choco"
                },
                {
                  "key": "species",
                  "value": "DOG"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Code is INVALID_API_KEY', () => pm.expect(pm.response.json().code).to.eql('INVALID_API_KEY'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error - invalid species (400)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/public/v1/foods/safety?query=choco&species=PERRO",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "v1",
                "foods",
                "safety"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "choco"
                },
                {
                  "key": "species",
                  "value": "PERRO"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Code is INVALID_PARAMETER', () => pm.expect(pm.response.json().code).to.eql('INVALID_PARAMETER'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Optional - add your own food",
      "description": "Optional. The instance already comes with 63 verified foods. Run these in order (01 to 07) only to add a food that is not in the catalog: set adminEmail and adminPassword first, and change the food name in request 02 so it does not clash with an existing one.",
      "item": [
        {
          "name": "01 Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Create food (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Galletas de avena\",\n  \"category\": \"snack\",\n  \"description\": \"Galletas caseras de avena sin chocolate ni pasas\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('foodId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Create food safety entry (admin, starts PENDING)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodId\": {{foodId}},\n  \"species\": \"DOG\",\n  \"lifeStage\": null,\n  \"riskLevel\": \"MODERATE\",\n  \"notes\": \"Ejemplo de evaluación creada a mano. Reemplaza este texto por información con fuentes verificables.\",\n  \"sources\": [\n    {\n      \"sourceName\": \"American Kennel Club\",\n      \"sourceUrl\": \"https://www.akc.org/expert-advice/nutrition/human-foods-dogs-can-and-cant-eat/\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/food-safety",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "food-safety"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('foodSafetyId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Register veterinarian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{vetName}}\",\n  \"email\": \"{{vetEmail}}\",\n  \"password\": \"{{vetPassword}}\",\n  \"role\": \"VETERINARIAN\",\n  \"licenseNumber\": \"DEMO-0001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('vetId', pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Approve veterinarian (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{vetId}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{vetId}}",
                "verify"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Veterinarian login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vetEmail}}\",\n  \"password\": \"{{vetPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('vetToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Verify food safety entry (veterinarian)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vetToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/food-safety/{{foodSafetyId}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "food-safety",
                "{{foodSafetyId}}",
                "verify"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Entry is VERIFIED', () => pm.expect(pm.response.json().verifiedStatus).to.eql('VERIFIED'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
